// A ptxas optimizer bug, found by kc-fuzz (random program testing), October 2026.
//
// The kernel computes  x[1] = (-abs(x[0]) >= -5)  and should store 1 when |x[0]| <= 5.
// With optimization on, ptxas decides the comparison is always false: the SASS
// does not even load x[0], it just stores 0 ("STG.E [R2.64+0x4], RZ").
//
//   ptxas -arch=sm_89 ptxas_neg_abs.ptx -o a.cubin && cuobjdump -sass a.cubin       wrong: no LDG
//   ptxas -arch=sm_89 -O0 ptxas_neg_abs.ptx -o a.cubin && cuobjdump -sass a.cubin   right: loads x[0]
//
// Seen with ptxas 13.3 (sm_75, sm_80, sm_86, sm_89, sm_90) and with the CUDA 13.1
// driver's JIT on an RTX 4060 (x[0] = 0, 3, -4 all give 0 instead of 1).
// Also wrong with "sub.s32 %r3, 0, %r2" instead of neg, and with setp.gt.
// nvcc doesn't hit it: its front end rewrites -abs(v) >= -5 into abs(v) < 6 first.

.version 8.0
.target sm_89
.address_size 64

.visible .entry k(.param .u64 p)
{
	.reg .pred 	%p<2>;
	.reg .b32 	%r<10>;
	.reg .b64 	%rd<2>;

	ld.param.u64 	%rd0, [p];
	cvta.to.global.u64 	%rd1, %rd0;
	ld.global.u32 	%r1, [%rd1];
	abs.s32 	%r2, %r1;
	neg.s32 	%r3, %r2;
	setp.ge.s32 	%p1, %r3, -5;
	selp.b32 	%r9, 1, 0, %p1;
	st.global.u32 	[%rd1+4], %r9;
	ret;
}

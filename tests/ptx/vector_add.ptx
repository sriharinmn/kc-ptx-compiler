// Hand-written PTX for  c[i] = a[i] + b[i]  (if i < n).
// Written before the compiler existed, to check that loading PTX and launching
// it on the GPU works on its own. The compiler's output should look similar.

.version 8.0
.target sm_89
.address_size 64

.visible .entry vector_add(
	.param .u64 vector_add_param_0,   // a
	.param .u64 vector_add_param_1,   // b
	.param .u64 vector_add_param_2,   // c
	.param .u32 vector_add_param_3    // n
)
{
	.reg .pred 	%p<1>;
	.reg .b32 	%r<5>;
	.reg .f32 	%f<3>;
	.reg .b64 	%rd<10>;

	// i = blockIdx.x * blockDim.x + threadIdx.x
	mov.u32 	%r0, %ctaid.x;
	mov.u32 	%r1, %ntid.x;
	mov.u32 	%r2, %tid.x;
	mad.lo.s32 	%r3, %r0, %r1, %r2;

	// if (i >= n) return;
	ld.param.u32 	%r4, [vector_add_param_3];
	setp.ge.s32 	%p0, %r3, %r4;
	@%p0 bra 	DONE;

	// pointer arguments are generic addresses: convert them to global addresses
	ld.param.u64 	%rd0, [vector_add_param_0];
	ld.param.u64 	%rd1, [vector_add_param_1];
	ld.param.u64 	%rd2, [vector_add_param_2];
	cvta.to.global.u64 	%rd3, %rd0;
	cvta.to.global.u64 	%rd4, %rd1;
	cvta.to.global.u64 	%rd5, %rd2;

	// byte offset of element i = i * 4
	mul.wide.s32 	%rd6, %r3, 4;
	add.s64 	%rd7, %rd3, %rd6;
	add.s64 	%rd8, %rd4, %rd6;
	add.s64 	%rd9, %rd5, %rd6;

	ld.global.f32 	%f0, [%rd7];
	ld.global.f32 	%f1, [%rd8];
	add.f32 	%f2, %f0, %f1;
	st.global.f32 	[%rd9], %f2;
DONE:
	ret;
}
